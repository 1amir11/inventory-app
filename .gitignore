# Build outputs, caches and local data - never committed.
__pycache__/
*.pyc
*.pyo
dist/
report.txt
*.log

# Live databases and backups (real owner data stays on the target PC only).
# NOTE: patterns with a slash anchor to this file's folder, so bare names
# are used to match app/data/ and app/data_demo/ at any depth.
*.db
*.db-wal
*.db-shm
*.db-journal
*-wal
*-shm
backups/

# Local workspace scraps.
.zwork/

# Large runtime binaries (Python embeddable + portable Firefox): staged
# locally under app/runtime/ for packaging, never committed. Only the
# instructions and the Firefox policies file are tracked.
app/runtime/*
!app/runtime/README.txt
!app/runtime/browser/
app/runtime/browser/*
!app/runtime/browser/distribution/
app/runtime/browser/distribution/*
!app/runtime/browser/distribution/policies.json
build_inputs/
*.exe
*.msi
!tests/
7za.exe
7z.exe
7z.dll
